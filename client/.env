# Main API Backend URL (Engine Server Load Balancer)
# For Local Development: http://localhost:5000
# For Production (Vercel/Render): Set in Vercel Dashboard to your Render Backend URL
# Example: VITE_API_BASE_URL=https://presencex-backend.onrender.com
VITE_API_BASE_URL=http://localhost:5000

# Admin Dashboard Access Key
VITE_ADMIN_KEY=admin123
